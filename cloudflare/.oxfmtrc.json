{
  "$schema": "./node_modules/oxfmt/configuration_schema.json",
  "semi": true,
  "singleQuote": false,
  "tabWidth": 2,
  "trailingComma": "all",
  "printWidth": 100,
  "ignorePatterns": [
    "dist/**",
    ".wrangler/**",
    "src/generated/**",
    "src/worker-configuration.d.ts",
    "migrations/**",
    "wrangler.jsonc",
    "wrangler.deploy.local.jsonc"
  ]
}
